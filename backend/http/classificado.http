@tokenMorador = eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiIwYmM4Yzk1OC1kYWNkLTQwMDMtYTc4Mi0wMDkxOTNkNTk5MjMiLCJmaW4iOiJBQ0VTU08iLCJpYXQiOjE3OTMzNzM5OTUsImV4cCI6MTc5MzM3NDg5NX0.iIw4aL-zJ7Ut7ntYOhgaAzVE_18VODrYhNZMihaneDDTWPXoaTcJ18SuJ_xvpQHl
@classificadoVendaId = d3beedf6-354e-468c-97a2-824179ee9bb7
@classificadoDoacaoId = a92dc64e-58c8-4a58-8544-9a96927aeb06
@classificadoSindicoId = 9aff7fff-04cd-41f5-b942-ce36f310b17b


### ============================================================
### 1. LOGIN
### ============================================================

### 1.1 Login do síndico (copie "token" para @tokenSindico)
POST {{baseUrl}}/usuario/login
Content-Type: application/json

{
  "cpf": "{{sindicoCpf}}",
  "senha": "{{senha}}"
}

### 1.2 Login do morador (copie "token" para @tokenMorador)
POST {{baseUrl}}/usuario/login
Content-Type: application/json

{
  "cpf": "{{moradorCpf}}",
  "senha": "{{senha}}"
}


### ============================================================
### 2. CRIAÇÃO E VALIDAÇÕES
### ============================================================

### 2.1 Morador anuncia venda (espera 201, status ATIVO)
# Copie "id" para @classificadoVendaId
POST {{baseUrl}}/classificado
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "condominioId": "{{condominioId}}",
  "titulo": "Bicicleta aro 26",
  "descricao": "Pouco usada, com freio a disco e cadeado.",
  "tipo": "VENDA",
  "preco": 350.00
}

### 2.2 Morador oferece doação (espera 201, sem preço)
# Copie "id" para @classificadoDoacaoId
POST {{baseUrl}}/classificado
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "condominioId": "{{condominioId}}",
  "titulo": "Sofá de 2 lugares",
  "descricao": "Em bom estado, precisa buscar.",
  "tipo": "DOACAO"
}

### 2.3 Venda sem preço (espera 400)
POST {{baseUrl}}/classificado
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "condominioId": "{{condominioId}}",
  "titulo": "Venda sem preço",
  "descricao": "Não deveria salvar.",
  "tipo": "VENDA"
}

### 2.4 Doação com preço (espera 400)
POST {{baseUrl}}/classificado
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "condominioId": "{{condominioId}}",
  "titulo": "Doação com preço",
  "descricao": "Não deveria salvar.",
  "tipo": "DOACAO",
  "preco": 10.00
}

### 2.5 Síndico anuncia serviço (espera 201)
# Copie "id" para @classificadoSindicoId
POST {{baseUrl}}/classificado
Content-Type: application/json
Authorization: Bearer {{tokenSindico}}

{
  "condominioId": "{{condominioId}}",
  "titulo": "Faxina de vidros",
  "descricao": "Limpeza de janelas externas, agendar pelo síndico.",
  "tipo": "SERVICO"
}

### 2.6 Tipo inexistente (espera 400)
POST {{baseUrl}}/classificado
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "condominioId": "{{condominioId}}",
  "titulo": "Tipo inválido",
  "descricao": "Teste.",
  "tipo": "TROCA"
}

### 2.7 Sem token (espera 401)
POST {{baseUrl}}/classificado
Content-Type: application/json

{
  "condominioId": "{{condominioId}}",
  "titulo": "Sem token",
  "descricao": "Não deveria salvar.",
  "tipo": "SERVICO"
}


### ============================================================
### 3. LISTAGEM (regra: morador vê ativos + próprios)
### ============================================================

### 3.1 Morador lista (espera 200, vê os próprios e os ativos de outros)
GET {{baseUrl}}/classificado/condominio/{{condominioId}}
Authorization: Bearer {{tokenMorador}}

### 3.2 Síndico lista (espera 200, vê todos, inclusive encerrados)
GET {{baseUrl}}/classificado/condominio/{{condominioId}}
Authorization: Bearer {{tokenSindico}}


### ============================================================
### 4. BUSCA POR ID
### ============================================================

### 4.1 Dono busca o próprio anúncio (espera 200)
GET {{baseUrl}}/classificado/{{classificadoVendaId}}
Authorization: Bearer {{tokenMorador}}

### 4.2 Síndico busca anúncio do morador (espera 200)
GET {{baseUrl}}/classificado/{{classificadoVendaId}}
Authorization: Bearer {{tokenSindico}}

### 4.3 Morador busca anúncio do síndico ativo (espera 200)
GET {{baseUrl}}/classificado/{{classificadoSindicoId}}
Authorization: Bearer {{tokenMorador}}

### 4.4 Anúncio inexistente (espera 404)
GET {{baseUrl}}/classificado/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{tokenMorador}}


### ============================================================
### 5. EDIÇÃO (só o dono)
### ============================================================

### 5.1 Síndico tenta editar anúncio do morador (espera 403)
PATCH {{baseUrl}}/classificado/{{classificadoVendaId}}
Content-Type: application/json
Authorization: Bearer {{tokenSindico}}

{
  "titulo": "Tentativa do síndico"
}

### 5.2 Dono altera o preço (espera 200)
PATCH {{baseUrl}}/classificado/{{classificadoVendaId}}
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "preco": 300.00
}

### 5.3 Dono troca venda por doação sem preço (espera 200)
PATCH {{baseUrl}}/classificado/{{classificadoVendaId}}
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "tipo": "DOACAO"
}

### 5.4 Dono tenta doação com preço (espera 400)
PATCH {{baseUrl}}/classificado/{{classificadoDoacaoId}}
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "preco": 20.00
}

### 5.5 Dono ajusta a descrição (espera 200)
PATCH {{baseUrl}}/classificado/{{classificadoDoacaoId}}
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "descricao": "Em bom estado, retirada no bloco A."
}


### ============================================================
### 6. STATUS (dono ou gestor encerra)
### ============================================================

### 6.1 Outro morador tenta encerrar (espera 403)
# Só funciona se houver um segundo morador; caso contrário, use o token do síndico
PATCH {{baseUrl}}/classificado/{{classificadoSindicoId}}/status
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "status": "ENCERRADO"
}

### 6.2 Dono encerra a própria doação (espera 200)
PATCH {{baseUrl}}/classificado/{{classificadoDoacaoId}}/status
Content-Type: application/json
Authorization: Bearer {{tokenMorador}}

{
  "status": "ENCERRADO"
}

### 6.3 Morador busca anúncio encerrado de outro, depois de encerrado (espera 403)
# Anúncio do síndico ainda não encerrado; use após o 6.4
GET {{baseUrl}}/classificado/{{classificadoDoacaoId}}
Authorization: Bearer {{tokenSindico}}

### 6.4 Síndico encerra anúncio do morador (espera 200)
PATCH {{baseUrl}}/classificado/{{classificadoVendaId}}/status
Content-Type: application/json
Authorization: Bearer {{tokenSindico}}

{
  "status": "ENCERRADO"
}

### 6.5 Status inválido (espera 400)
PATCH {{baseUrl}}/classificado/{{classificadoVendaId}}/status
Content-Type: application/json
Authorization: Bearer {{tokenSindico}}

{
  "status": "VENDIDO"
}
### 6.6 Síndico encerra o próprio anúncio (espera 200)
PATCH {{baseUrl}}/classificado/{{classificadoSindicoId}}/status
Content-Type: application/json
Authorization: Bearer {{tokenSindico}}

{
  "status": "ENCERRADO"
}

### ============================================================
### 7. VISIBILIDADE APÓS ENCERRAR
### ============================================================

### 7.1 Morador não vê anúncio encerrado de outro (espera 403)
# Anúncio encerrado pelo síndico (6.4), não é do morador
GET {{baseUrl}}/classificado/{{classificadoSindicoId}}
Authorization: Bearer {{tokenMorador}}

### 7.2 Morador ainda vê o próprio anúncio encerrado (espera 200)
GET {{baseUrl}}/classificado/{{classificadoDoacaoId}}
Authorization: Bearer {{tokenMorador}}

### 7.3 Morador lista e não vê os encerrados de outros (espera 200)
GET {{baseUrl}}/classificado/condominio/{{condominioId}}
Authorization: Bearer {{tokenMorador}}